# Bolna web-call voice agent (used by netlify/functions/bolna-session.mjs).
# Copy to .env for local preview; set the same values in Hostinger runtime environment variables (or Netlify).
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Website project enquiries (server-enquiry.mjs). Set in Hostinger runtime environment variables.
# Without these the form hands each enquiry to WhatsApp (+91 98199 95285) instead of email.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO=sales@prorack.ai
